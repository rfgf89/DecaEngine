<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Headless probes: the numeric reports the engine is verified with, without a GUI and without
		eyes. Their output becomes the baselines in tools/baselines, checked by
		tools/Run-ProbeSuite.ps1.

		The probes that moved here are the ones that need NOTHING from the editor: physics,
		procedural animation, humanoid mapping, ragdoll, the animation report and the CPU/GPU probe
		GI traversal comparison. While they sat in DecaEngine.Editor they had access to all of its
		internals - and the fact that they did not use it was enforced by nothing. Now the compiler
		enforces it.

		The remaining seven (PreviewProbe, ScenePhysicsProbe, FullLoopProbe and others) hold on to
		the editor viewports and will move once the editor itself becomes a library and the exe
		becomes thin.
	-->
	<ItemGroup>
		<ProjectReference Include="..\DecaEngine.Animation\DecaEngine.Animation.csproj" />
		<ProjectReference Include="..\DecaEngine.Core\DecaEngine.Core.csproj" />
		<ProjectReference Include="..\DecaEngine.Editor\DecaEngine.Editor.csproj" />
		<ProjectReference Include="..\DecaEngine.Graphics.Core\DecaEngine.Graphics.Core.csproj" />
		<ProjectReference Include="..\DecaEngine.Graphics.Diligent\DecaEngine.Graphics.Diligent.csproj" />
		<ProjectReference Include="..\DecaEngine.Graphics.ProbeGi\DecaEngine.Graphics.ProbeGi.csproj" />
		<ProjectReference Include="..\DecaEngine.Physics.Bepu\DecaEngine.Physics.Bepu.csproj" />
		<ProjectReference Include="..\DecaEngine.Scene\DecaEngine.Scene.csproj" />
	</ItemGroup>

</Project>
