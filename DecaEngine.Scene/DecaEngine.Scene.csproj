<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The scene: the ECS components and systems a frame is assembled from - transforms and render
		data, culling, lights and the shadow slice scheduler, animation and gameplay components, the
		bridge to physics.

		This used to live in DecaEngine.Editor, mixed in with the windows. What stayed behind tells
		the story: the editor kept exactly those systems tied to editor-only entities - ModelStore,
		the viewport preview environment, preview shadow settings. Nothing else had anything to do
		with the editor: the very same components and systems are driven by the headless probes, and
		will be driven by the game.

		There is NO backend here: the scene builds a frame through IBatchRenderer and the frame
		structs from Graphics.Core (DrawData, GPURenderInstance, BatchSubset, ShadowLayout). Which
		renderer executes them is up to whoever creates the scene.
	-->
	<ItemGroup>
		<ProjectReference Include="..\DecaEngine.Core\DecaEngine.Core.csproj" />
		<ProjectReference Include="..\DecaEngine.Graphics.Core\DecaEngine.Graphics.Core.csproj" />
		<ProjectReference Include="..\DecaEngine.Physics.Bepu\DecaEngine.Physics.Bepu.csproj" />
	</ItemGroup>

</Project>
