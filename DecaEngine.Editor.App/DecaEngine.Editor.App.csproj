<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The entry point: command line argument parsing and startup - either the editor or one of the
		headless probes.

		It exists so that DecaEngine.Editor can be a LIBRARY. While the editor was the exe itself,
		the probes had to live inside it: nothing outside could reference the editor, and the Main
		that dispatched them lived there too. Hence nine and a half thousand lines of test harness
		sitting among the ImGui windows.

		The arrows are untangled now: Probes -> Editor (the probes need the viewports), App -> both
		(it has to be able to launch either). There are no arrows back.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\DecaEngine.Editor\DecaEngine.Editor.csproj" />
		<ProjectReference Include="..\DecaEngine.Probes\DecaEngine.Probes.csproj" />
	</ItemGroup>

</Project>
