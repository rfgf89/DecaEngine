// Пиксельная часть дебаг-вида проб (см. ProbeDebugVS.hlsl). Кодировка:
//   цвет шарика   - SH L0 пробы: что она реально накопила (тёмная в тени, яркая у света);
//   красный       - невалидная проба (доля задних граней высока - считает себя в стене; после
//                   релокации таких почти не должно оставаться);
//   голубая кромка - проба ПЕРЕЕХАЛА релокацией (чем длиннее смещение, тем заметнее) - видно,
//                   кого вытащило из геометрии.
struct PSInput
{
    float4 pos       : SV_POSITION;
    float3 normal    : NORMAL;
    float4 color     : COLOR0;
    float  offsetLen : TEXCOORD0;
    float3 tint      : TEXCOORD1;
};

float4 Main(PSInput input) : SV_TARGET
{
    // Простейшая двусторонняя подсветка сверху: гранёная форма читается, цвет поля не искажён.
    float shade = 0.6 + 0.4 * saturate(input.normal.y * 0.5 + 0.5);
    float3 color = input.color.rgb * shade;

    // Невалидность - красным поверх поля: у пробы в стене L0 и так почти чёрный, без подкраски
    // она просто сливалась бы с тенью.
    float invalid = 1.0 - saturate(input.color.a);
    color = lerp(color, float3(1.0, 0.05, 0.05) * shade, invalid * invalid);

    // Переехавшие - голубая кромка по силуэту (по граням, смотрящим вбок).
    float rim = 1.0 - abs(input.normal.y);
    color += float3(0.1, 0.6, 1.0) * saturate(input.offsetLen) * rim * 0.6;

    // Метка объёма: шарики каскадов подкрашены аддитивно и потому видны и на тёмных пробах -
    // иначе среди тысяч базовых шариков их не различить (они мельче, а цвет поля тот же).
    color += input.tint * shade * 0.35;

    return float4(color, 1.0);
}
