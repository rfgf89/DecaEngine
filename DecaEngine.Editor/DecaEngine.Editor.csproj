<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A library, not an exe. The entry point lives in DecaEngine.Editor.App - that is the only way
        the probes project, which needs the editor viewports, can reference the editor.
    -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\DecaEngine.Core.Build\DecaEngine.Core.Build.csproj" />
      <ProjectReference Include="..\DecaEngine.Core\DecaEngine.Core.csproj" />
      <ProjectReference Include="..\DecaEngine.Generic\DecaEngine.Generic.csproj" />
      <ProjectReference Include="..\DecaEngine.Graphics.Core\DecaEngine.Graphics.Core.csproj" />
      <ProjectReference Include="..\DecaEngine.Graphics.ProbeGi\DecaEngine.Graphics.ProbeGi.csproj" />
      <ProjectReference Include="..\DecaEngine.Scene\DecaEngine.Scene.csproj" />
      <ProjectReference Include="..\DecaEngine.ImGui.Core\DecaEngine.ImGui.Core.csproj" />
      <ProjectReference Include="..\DecaEngine.Input.Sdl3\DecaEngine.Input.Sdl3.csproj" />
      <ProjectReference Include="..\DecaEngine.Graphics.Diligent\DecaEngine.Graphics.Diligent.csproj" />
      <ProjectReference Include="..\DecaEngine.ImGui.DiligentRender\DecaEngine.ImGui.DiligentRender.csproj" />
      <ProjectReference Include="..\DecaEngine.Physics.Bepu\DecaEngine.Physics.Bepu.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Hexa.NET.ImGui.Widgets" Version="1.2.18" />
      <!-- Explicit pin against an ABI mismatch: Widgets pulls in ImGuizmo 2.2.8.4, while our ImGui
           is a direct reference to 2.2.10-prerelease. Native cimguizmo 2.2.8.4 then reads a cimgui
           2.2.10 context struct - that was the "intermittent 0xC0000005 in BeginFrameNative": not a
           race, but a memory layout that lined up only half the time. The version MUST match
           Hexa.NET.ImGui (see ImGui.Core). -->
      <PackageReference Include="Hexa.NET.ImGuizmo" Version="2.2.10-prerelease" />
      <PackageReference Include="Microsoft.Build.Runtime" Version="18.6.3" ExcludeAssets="runtime;contentFiles" />
      <!-- Transitive pin: the MSBuild packages pull in 10.0.3, which has a known vulnerability
           (NU1903, GHSA-23rf-6693-g89p). A direct reference bumps it to the fixed version. -->
      <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    </ItemGroup>
	
