<Project>

	<!--
		Properties shared by every project in the repo. MSBuild imports this BEFORE the body of
		each csproj, so any project can override anything from its own PropertyGroup - the
		generators (netstandard2.0) and the vendored libraries rely on that.

		Why: before this file, seventeen csproj files copied the same four lines and drifted
		apart. The telling case was <Platforms>: only some projects declared it, so building the
		whole solution with -p:Platform=x64 (Diligent does not work on AnyCPU) behaved differently
		from project to project.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- The engine works with native memory throughout: Unsafe* collections, Diligent interop,
		     the ozz shim, mesh loading. Enabled everywhere so that moving a file from one project
		     to another never surfaces as a compile error. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- x86 stays for the 32-bit probes; ARM64 because EditorPlatform can return it
		     (see ProjectSession.EditorPlatform), and without declaring it here a user project
		     build on ARM64 would fail on an unknown platform. -->
		<Platforms>x64;x86;ARM64</Platforms>
	</PropertyGroup>

</Project>
