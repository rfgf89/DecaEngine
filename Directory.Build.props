<Project>

	<!--
		Общие свойства всех проектов репозитория. Импортируется MSBuild'ом ДО тела каждого
		csproj, поэтому любой проект может переопределить что угодно своим PropertyGroup -
		этим пользуются генераторы (netstandard2.0) и вендоренные библиотеки.

		Зачем: до этого файла семнадцать csproj копировали одни и те же четыре строки, и
		расходились. Показательный случай - <Platforms>: он был объявлен только у части
		проектов, из-за чего сборка всего решения с -p:Platform=x64 (Diligent не работает на
		AnyCPU) вела себя по-разному от проекта к проекту.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Движок насквозь работает с нативной памятью: Unsafe*-коллекции, интероп Diligent,
		     ozz-шим, загрузка мешей. Разрешаем везде, чтобы это не всплывало как ошибка при
		     переносе файла из проекта в проект. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- x86 остаётся ради 32-битных проб; ARM64 - потому что EditorPlatform умеет его
		     вернуть (см. ProjectSession.EditorPlatform), а без объявления здесь сборка
		     пользовательского проекта на ARM64 падала бы на неизвестной платформе. -->
		<Platforms>x64;x86;ARM64</Platforms>
	</PropertyGroup>

</Project>
