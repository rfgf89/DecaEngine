<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
	  <ProjectReference Include="..\DecaEngine.Graphics.Diligent\DecaEngine.Graphics.Diligent.csproj" />
	  <ProjectReference Include="..\DecaEngine.ImGui.Core\DecaEngine.ImGui.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Evergine.Mathematics" Version="2026.5.26.372" />
    </ItemGroup>

    <!--
        The ImGui shaders ship with this project, not with the application.
        ImGuiDiligentRender.CreateDeviceResources looks for them at <working directory>/Assets/Shaders,
        so anyone who plugs in this renderer must get them into their own output.

        They used to live in the SAMPLES project (DecaEngine/Assets/Shaders), mixed in with thirteen
        demo shaders, and the editor only got them because it referenced the samples. When that
        reference was dropped as unnecessary, the editor stopped starting up: Diligent could not
        create the font shaders, the PSO was left without a vertex shader, and the crash surfaced as
        a NullReferenceException.
    -->
    <ItemGroup>
      <Content Include="Assets\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
