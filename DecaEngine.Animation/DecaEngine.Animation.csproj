<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Animation runtime: skeleton and clips as data, posing and sampling through native ozz,
		additive clips, foot IK, spring bones, the humanoid avatar and its reference pose.

		This used to live in DecaEngine.Graphics.Core, even though there is no graphics in it: none
		of the nine files has a single using on DecaEngine - only System.*. Its one external
		dependency was Transform, declared in the middle of ModelLoader.cs; that moved to Core.

		The import side (SkinningImport - parsing the skin out of glTF) stayed in Graphics.Core next
		to ModelLoader: it belongs to model loading, not to animation playback. The direction came
		out as Graphics.Core -> Animation: the loader PRODUCES PreparedSkeleton/PreparedAnimation,
		the runtime CONSUMES them. There is no arrow back.
	-->
	<ItemGroup>
		<ProjectReference Include="..\DecaEngine.Core\DecaEngine.Core.csproj" />
	</ItemGroup>

</Project>
