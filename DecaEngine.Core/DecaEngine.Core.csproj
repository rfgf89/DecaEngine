<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DiligentGraphics.DiligentEngine.Core" Version="2.5.6" />
      <PackageReference Include="Evergine.Mathematics" Version="2026.5.26.372" />
      <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
      <PackageReference Include="Friflo.Engine.ECS.Boost" Version="4.0.0-preview.2" />
      <PackageReference Include="Friflo.Engine.ECS.Generators" Version="3.6.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" ExcludeAssets="runtime" />
      <!--
        Microsoft.CodeAnalysis.Workspaces.MSBuild транзитивно тянет свою версию
        Microsoft.Build/Microsoft.Build.Framework. Без явного пиннинга их версии
        с ExcludeAssets="runtime" их DLL копируются в выходную папку и конфликтуют
        по версии с тем, что резолвит Microsoft.Build.Locator из установленной
        .NET SDK (см. DecaEngine.Core.Build.csproj) — это приводит к падению
        "The type initializer for 'Microsoft.Build.Shared.Debugging.DebugUtils'
        threw an exception." Пиннингом версии и исключением runtime-ассетов здесь
        гарантируем, что во всём решении используется только одна версия этих
        пакетов и её бинарники никогда не копируются в output.
      -->
      <PackageReference Include="Microsoft.Build" Version="18.6.3" ExcludeAssets="runtime" />
      <PackageReference Include="Microsoft.Build.Framework" Version="18.6.3" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="EditorAssets\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="EditorAssets\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="EditorAssets\**" />
    </ItemGroup>

</Project>
